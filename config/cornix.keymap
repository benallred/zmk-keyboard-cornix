#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Layers
#define BASE     0
#define PARENS   1
#define SYMn10K  2
#define NAV      3
#define FUNCTION 4
#define MEDIA    5
#define KEYBOARD 6

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_LB LH3 LH4 LH5
#define KEYS_RB RH3 RH4 RH5
#define THUMBS LH0 LH1 LH2 RH0 RH1 RH2
#define ENCODERS LEC REC

#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            // quick-tap-ms = <200>;
            // require-prior-idle-ms = <70>;
            // hold-trigger-key-positions = <KEYS_R KEYS_T>;
            // hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            // quick-tap-ms = <200>;
            // require-prior-idle-ms = <70>;
            // hold-trigger-key-positions = <KEYS_L KEYS_T>;
            // hold-trigger-on-release;
        };

        // lt: layer_tap {
        //     compatible = "zmk,behavior-hold-tap";
        //     #binding-cells = <2>;
        //     bindings = <&mo>, <&kp>;

        //     flavor = "hold-preferred";
        //     tapping-term-ms = <200>;
        //     quick-tap-ms = <200>;
        // };

        xcv: tap_dance_clipboard {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mt LC(C) LC(V)>, <&mt LC(X) LC(LS(V))>;
            tapping-term-ms = <200>;
        };

        #define FUNCTION_KEY(name, key, ...) \
        name: name { \
            compatible = "zmk,behavior-tap-dance"; \
            #binding-cells = <0>; \
            bindings = <&mt LC(key) key>, <&mt LS(key) LA(key)>; \
            tapping-term-ms = <200>; \
            __VA_ARGS__ \
        };
        FUNCTION_KEY(f1, F1)
        FUNCTION_KEY(f2, F2)
        FUNCTION_KEY(f3, F3)
        FUNCTION_KEY(f4, F4)
        FUNCTION_KEY(f5, F5)
        FUNCTION_KEY(f6, F6)
        FUNCTION_KEY(f7, F7)
        FUNCTION_KEY(f8, F8)
        FUNCTION_KEY(f9, F9)
        FUNCTION_KEY(f10, F10)
        FUNCTION_KEY(f11, F11)
        FUNCTION_KEY(f12, F12)

        #define NUMBER_ROW_KEY(name, key, ...) \
        name: name { \
            compatible = "zmk,behavior-tap-dance"; \
            #binding-cells = <0>; \
            bindings = <&mt LC(key) LG(key)>, <&kp LG(LC(LS(key)))>; \
            tapping-term-ms = <200>; \
            __VA_ARGS__ \
        };
        NUMBER_ROW_KEY(n1, N1)
        NUMBER_ROW_KEY(n2, N2)
        NUMBER_ROW_KEY(n3, N3)
        NUMBER_ROW_KEY(n4, N4)
        NUMBER_ROW_KEY(n5, N5)
        NUMBER_ROW_KEY(n6, N6)
        NUMBER_ROW_KEY(n7, N7)
        NUMBER_ROW_KEY(n8, N8)
        NUMBER_ROW_KEY(n9, N9)
        NUMBER_ROW_KEY(n0, N0)

        #define BLUETOOTH_KEY(name, profile, ...) \
        name: name { \
            compatible = "zmk,behavior-tap-dance"; \
            #binding-cells = <0>; \
            bindings = <&bt BT_SEL profile>, <&bt BT_DISC profile>; \
            tapping-term-ms = <200>; \
            __VA_ARGS__ \
        };
        BLUETOOTH_KEY(bt0, 0)
        BLUETOOTH_KEY(bt1, 1)
        BLUETOOTH_KEY(bt2, 2)
    };

    macros {
        ZMK_MACRO(thin_arrow,
            bindings = <&kp MINUS>, <&kp GT>;
        )

        ZMK_MACRO(fat_arrow,
            bindings = <&kp SPACE>, <&kp EQUAL>, <&kp GT>, <&kp SPACE>;
        )

        ZMK_MACRO(c_drive,
            bindings = <&kp LS(C)>, <&kp COLON>, <&kp BSLH>;
        )
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESC>;
            key-positions = <LT2 LT3>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <RB2 RB3>;
            layers = <BASE>;
        };

        caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <LT5 RT5>;
            layers = <BASE>;
        };

        kp_dot {
            bindings = <&kp KP_DOT>;
            key-positions = <RB2 RB3>;
            layers = <SYMn10K>;
        };

        kp_colon {
            bindings = <&kp COLON>;
            key-positions = <RB1 RB2>;
            layers = <SYMn10K>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&sk LSHIFT  &kp Q             &kp W        &lt PARENS F  &kp P         &lt KEYBOARD B                               &kp J          &kp L          &lt PARENS U  &kp Y         &kp SEMI     &sk RSHIFT
&xcv        &hml LGUI A       &hml LALT R  &hml LCTRL S  &hml LSHFT T  &kp G                                        &kp M          &hmr RSHFT N   &hmr RCTRL E  &hmr RALT I   &hmr RGUI O  &kp SQT
&caps_word  &hml LC(LSHFT) Z  &kp X        &kp C         &kp D         &kp V        &kp LC(KP_N0)    &kp C_MUTE     &kp K          &kp H          &kp COMMA     &kp DOT       &kp FSLH     &kp GRAVE
&kp LC(S)   &kp LC(A)         &kp LC(Z)                  &mo FUNCTION  &kp ENTER    &lt SYMn10K TAB  &lt NAV SPACE  &kp BACKSPACE  &mo FUNCTION                 &mo MEDIA     &none        &none
            >;
            sensor-bindings =
                <&inc_dec_kp LC(EQUAL) LC(MINUS)>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        parens {
            display-name = "Parentheses";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                  &thin_arrow  &kp BSLH         &trans                 &kp FSLH           &trans  &c_drive
                &trans  &trans  &trans  &trans  &trans  &trans                  &fat_arrow   &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET   &kp LT  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp GT  &trans
                &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans       &trans                                  &trans             &trans  &trans
            >;
        };

        symbols_and_10_key {
            display-name = "Symbols & 10 Key";
            bindings = <
                &trans  &kp UNDER        &kp AT     &kp HASH       &kp DOLLAR    &kp PIPE                      &trans      &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY  &kp KP_DIVIDE
                &trans  &kp EXCLAMATION  &kp PLUS   &kp MINUS      &kp EQUAL     &kp QUESTION                  &kp K_CALC  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS      &kp KP_MINUS
                &trans  &kp PERCENT      &kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans        &trans  &trans  &kp COMMA   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER     &trans
                &trans  &trans           &trans                    &trans        &trans        &trans  &trans  &trans      &kp KP_N0             &trans     &trans           &trans
            >;
        };

        navigation {
            display-name = "Navigation";
            bindings = <
                &trans  &trans    &trans    &trans     &trans     &trans                  &trans   &kp PG_UP  &kp UP    &kp PG_DN  &trans     &trans
                &trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans                  &trans   &kp LEFT   &kp DOWN  &kp RIGHT  &trans     &trans
                &trans  &trans    &trans    &trans     &trans     &trans  &trans  &trans  &kp DEL  &kp HOME   &kp END   &trans     &kp LCTRL  &trans
                &trans  &trans    &trans               &trans     &trans  &trans  &trans  &trans   &trans               &trans     &trans     &trans
            >;
        };

        function {
            display-name = "Function";
            bindings = <
                &kp LA(F4)       &trans  &trans        &kp LG(UP)    &trans         &kp LG(PG_UP)                  &kp K_APP      &f9     &f10  &f11    &f12    &kp PRINTSCREEN
                &trans           &trans  &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)  &kp LG(PG_DN)                  &kp LA(SPACE)  &f5     &f6   &f7     &f8     &kp LG(PAUSE_BREAK)
                &trans           &trans  &trans        &trans        &trans         &trans         &trans  &trans  &trans         &f1     &f2   &f3     &f4     &trans
                &kp LC(LS(ESC))  &trans  &trans                      &trans         &trans         &trans  &trans  &trans         &trans        &trans  &trans  &trans
            >;
        };

        media {
            display-name = "Media";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans      &trans      &kp C_VOL_UP  &trans      &trans
                &trans  &n1     &n2     &n3     &n4     &n5                     &trans  &trans      &kp C_PREV  &kp C_PP      &kp C_NEXT  &trans
                &trans  &n6     &n7     &n8     &n9     &n0     &trans  &trans  &trans  &kp C_MUTE  &trans      &kp C_VOL_DN  &trans      &trans
                &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans      &trans
            >;
        };

        keyboard {
            display-name = "Keyboard";
            bindings = <
                &bootloader  &bt0    &bt1    &bt2    &bt BT_CLR  &trans                  &trans  &trans  &trans  &trans  &trans  &bootloader
                &trans       &trans  &trans  &trans  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans       &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans       &trans  &trans          &trans      &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        // template {
        //     display-name = "Template";
        //     bindings = <
        //         &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        //         &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        //         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        //         &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans
        //     >;
        // };
    };
};
